<?php

// check if tasks.json exist
if (!file_exists('tasks.json')) {
    file_put_contents('tasks.json', []);
}

$tasks = json_decode(file_get_contents('tasks.json'), true);

switch ($argv[1] ?? null) {
    case 'add':        
        $input = [
            'id' => empty($tasks) ? 1 : max(array_column($tasks, 'id')) + 1,
            'description' => $argv[2],
            'status' => 'todo',
            'createdAt' => date("Y-m-d H:i:s"),
            'updatedAt' => date("Y-m-d H:i:s"),
        ];

        $tasks[] = $input;

        file_put_contents('tasks.json', json_encode($tasks, JSON_PRETTY_PRINT));

        echo "Task added successfully (ID: {$input['id']}) \n";

        break;

    case 'update':
        echo "update";

        break;

    case 'delete':
        echo "delete";

        break;

    case 'mark-in-progress':
        echo "mark-in-progress";

        break;

    case 'mark-done':
        echo "mark-done";

        break;

    case 'list':
        switch (true) {
            case !isset($argv[2]):
                echo "list";

                break;

            case ($argv[2] === 'done'):
                echo "list done";

                break;

            case ($argv[2] === 'todo'):
                echo "list todo";

                break;

            case ($argv[2] === 'in-progress'):
                echo "list in-progress";

                break;
        }
        
        break;

    default:
        echo "Please enter a valid command \n";

        break;
}
<?php

// check if dir exist
if (!is_dir('data')) {
    mkdir('data', 0777, true);
}

// check if tasks.json exist
if (!file_exists('data/tasks.json')) {
    file_put_contents('data/tasks.json', json_encode([]));
}

$commands = [
    'add',
    'update',
    'delete',
    'mark-in-progress',
    'mark-done',
    'list',
    'list done',
    'list todo',
    'list in-progress',
];

$tasks = json_decode(file_get_contents('data/tasks.json'), true);

switch ($argv[1] ?? null) {
    case 'add':        
        $input = [
            'id' => empty($tasks) ? 1 : max(array_column($tasks, 'id')) + 1,
            'description' => $argv[2] ?? null,
            'status' => 'todo',
            'createdAt' => date("Y-m-d H:i:s"),
            'updatedAt' => date("Y-m-d H:i:s"),
        ];

        if (empty($input['description'])) {
            echo "The description cant be empty \n";

            break;
        }

        $tasks[] = $input;

        file_put_contents('data/tasks.json', json_encode($tasks, JSON_PRETTY_PRINT));

        echo "Task added successfully (ID: {$input['id']}) \n";

        break;

    case 'update':
        $id = $argv[2] ?? null;
        $description = $argv[3] ?? null;
        $updatedAt = date("Y-m-d H:i:s");
        $found = false;

        foreach ($tasks as &$task) {
            if ($task['id'] == $id) {
                $found = true;

                if ($task['description'] === $description) {
                    echo "bruh, it is the same description, just don't update it. \n";

                    break;
                } elseif ($description === null) {
                    echo "the description just can not be empty \n";

                    break;
                }

                $task['description'] = $description;
                $task['updatedAt'] = $updatedAt;

                file_put_contents('data/tasks.json', json_encode($tasks, JSON_PRETTY_PRINT));
                
                echo "Task updated successfully (ID: {$id}) \n";

                break;
            }
        }

        if ($found === false) {
            if ($id === null) {
                echo "Please input the ID mate. \n";
            } else {
                echo "Task not found.\n";
            }
        }

        break;

    case 'delete':
        $id = $argv[2] ?? null;
        $found = false;

        foreach ($tasks as $index => $task) {
            if ($task['id'] == $id) {
                $found = true;
                unset($tasks[$index]);

                file_put_contents('data/tasks.json', json_encode(array_values($tasks), JSON_PRETTY_PRINT));
                
                echo "Task deleted \n";

                break;
            }
        }

        if ($found === false) {
            if ($id === null) {
                echo "Please input the ID mate. \n";
            } else {
                echo "Task not found \n";
            }
        }

        break;

    case 'mark-in-progress':
        $id = $argv[2] ?? null;
        $status = 'in-progress';
        $updatedAt = date("Y-m-d H:i:s");

        $found = false;

        foreach ($tasks as &$task) {
            if ($task['id'] == $id) {
                $found = true;
                
                if ($status == $task['status']) {
                    echo "bruh, it is the same status, just don't update it. \n";

                    break;
                }

                $task['status'] = $status;
                $task['updatedAt'] = $updatedAt;

                file_put_contents('data/tasks.json', json_encode($tasks, JSON_PRETTY_PRINT));
                
                echo "Status marked to {$status} (ID: {$id}) \n";

                break;
            }
        }
        
        if ($found === false) {
            if ($id === null) {
                echo "Please input the ID mate. \n";
            } else {
                echo "Task not found \n";
            }
        }

        break;

    case 'mark-done':
        $id = $argv[2] ?? null;
        $status = 'done';
        $updatedAt = date("Y-m-d H:i:s");

        $found = false;

        foreach ($tasks as &$task) {
            if ($task['id'] == $id) {
                $found = true;
                
                if ($status == $task['status']) {
                    echo "bruh, it is the same status, just don't update it. \n";

                    break;
                }

                $task['status'] = $status;
                $task['updatedAt'] = $updatedAt;

                file_put_contents('data/tasks.json', json_encode($tasks, JSON_PRETTY_PRINT));
                
                echo "Status marked to {$status} (ID: {$id}) \n";

                break;
            }
        }
        
        if ($found === false) {
            if ($id === null) {
                echo "Please input the ID mate. \n";
            } else {
                echo "Task not found \n";
            }
        }

        break;

    case 'list':
        switch (true) {
            case !isset($argv[2]):
                $found = false;

                foreach ($tasks ?? [] as $task) {
                    $found = true;

                    echo $task['description'] . "\n";
                }

                if ($found === false) {
                    echo "There is no task to be listed \n";
                }

                break;

            case ($argv[2] === 'done'):
                $found = false;
                
                foreach ($tasks ?? [] as $task) {
                    if ($task['status'] === 'done') {
                        $found = true;

                        echo $task['description'] . "\n";
                    }
                }

                if ($found === false) {
                    echo "There is no task with status 'done' \n";
                    
                    break;
                }

                break;

            case ($argv[2] === 'todo'):
                $found = false;
                
                foreach ($tasks ?? [] as $task) {
                    if ($task['status'] === 'todo') {
                        $found = true;
                        echo $task['description'] . "\n";
                    }
                }

                if ($found === false) {
                    echo "There is no task with status 'todo' \n";
                    
                    break;
                }

                break;

            case ($argv[2] === 'in-progress'):
                $found = false;
                
                foreach ($tasks ?? [] as $task) {
                    if ($task['status'] === 'in-progress') {
                        $found = true;
                        echo $task['description'] . "\n";
                    }
                }

                if ($found === false) {
                    echo "There is no task with status 'in-progress' \n";
                    
                    break;
                }

                break;
        }
        
        break;

    default:
        echo "Please enter a valid command \n";

        foreach ($commands as $command) {
            echo " - $command \n";
        }

        break;
}